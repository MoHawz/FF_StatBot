# Copy this file to .env and fill in your values. Never commit the real .env.

ESPN_LEAGUE_ID=0000000
ESPN_SEASON_YEAR=2026

# Only needed if your league is private (see SETUP.md for how to find these)
ESPN_S2=
ESPN_SWID=

# GroupMe bot (see SETUP.md)
GROUPME_BOT_ID=
# Optional: only needed to post tables as images instead of plain text
# (see SETUP.md "Posting reports as images")
GROUPME_ACCESS_TOKEN=

# Google Sheets (see SETUP.md)
GOOGLE_SERVICE_ACCOUNT_JSON=./service_account.json
GOOGLE_SHEET_ID=

# Cosmetic only -- shown as the subtitle/footer text on the rendered image
# cards. Kept as env vars (not hard-coded) so this repo can stay public
# without the source revealing your actual league or bot name.
LEAGUE_DISPLAY_NAME=Fantasy League
BOT_NAME=Stat Bot
# Optional: local path to your league's logo image. Same reasoning as the
# two above -- the actual image file lives on your machine and is never
# committed, only its path. Works best as a PNG on a plain white or
# transparent background; a badge/crest shape reads cleaner than a wide
# logo at the small sizes these cards use it at.
LOGO_PATH=
